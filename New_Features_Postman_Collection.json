						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"sender_type\": \"user\",\n    \"content\": \"أعطني إحصائيات النظام كاملة لو سمحت ثم ابعتها على الواتساب\"\n}",
							"options": {

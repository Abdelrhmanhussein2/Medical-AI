		{
			"name": "2. Clinical Note Templates",
			"item": [
				{
					"name": "Create Template",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.id) {",
									"    pm.collectionVariables.set(\"templateId\", jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{doctorToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"متابعة السكري والضغط\",\n    \"fields\": [\n        { \"label\": \"ضغط الدم\" },\n        { \"label\": \"مستوى السكر العشوائي\" },\n        { \"label\": \"الأعراض الحالية\" },\n        { \"label\": \"الخطة العلاجية المقترحة\" }\n    ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/templates/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"templates",
								""
							]
						},
						"description": "Creates a clinical note template for a doctor (max 6 fields)."
					},
					"response": []
				},
				{
					"name": "Get Doctor Templates",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{doctorToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/templates/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"templates",
								""
							]
						},
						"description": "Lists all note templates designed by the logged in doctor."
					},
					"response": []
				},
				{
					"name": "Search Field Registry",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{doctorToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/templates/registry/search?q=ضغط",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"templates",
								"registry",
								"search"
							],
							"query": [
								{
									"key": "q",
									"value": "ضغط"
								}
							]
						},
						"description": "Searches global field autocomplete registry for suggestions."
					},
					"response": []
				},
				{
					"name": "Save Patient Template Values (Upsert)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{doctorToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"patient_id\": \"{{patientId}}\",\n    \"template_id\": \"{{templateId}}\",\n    \"filled_data\": {\n        \"ضغط الدم\": \"120/80\",\n        \"مستوى السكر العشوائي\": \"140 mg/dL\",\n        \"الأعراض الحالية\": \"صداع خفيف ومستمر في الجبهة\",\n        \"الخطة العلاجية المقترحة\": \"الاستمرار على العلاج وزيادة شرب السوائل\"\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/templates/patients/fills",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"templates",
								"patients",
								"fills"
							]
						},
						"description": "Saves template field values for a patient during session (updates if already exists)."
					},
					"response": []
				},
				{
					"name": "Get Patient Fills History",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{doctorToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/templates/patients/{{patientId}}/fills",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"templates",
								"patients",
								"{{patientId}}",
								"fills"
							]
						},
						"description": "Retrieves note templates filled previously for this patient."
					},
					"response": []
				},
				{
					"name": "Delete Template",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{doctorToken}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/templates/{{templateId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"templates",
								"{{templateId}}"
							]
						},
						"description": "Deletes a template (checks doctor ownership)."
					},
					"response": []
				}
			]
		},
